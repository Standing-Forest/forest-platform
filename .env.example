# Copy to .env and adjust. Compose sets these for you; this file is for running
# the app directly on a host.

# --- required -------------------------------------------------------------

# How principals are authenticated. Release 0 defines NO authentication
# contract, so this must be chosen explicitly — there is no safe default.
# Only 'dev-headers' exists, and it is refused when NODE_ENV=production.
AUTH_MODE=dev-headers

NODE_ENV=development

# --- database -------------------------------------------------------------

DATABASE_URL=postgres://postgres:postgres@localhost:5432/forest_platform

# --- server ---------------------------------------------------------------

HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Identity of this deployment. Stamped onto every domain event as
# sourceInstanceId, and used as the tenant for the dev seed.
INSTANCE_ID=00000000-0000-7000-8000-000000000001
SERVICE_NAME=forest-platform-api

# --- outbox publisher -----------------------------------------------------

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100

# --- specification package ------------------------------------------------

# Where the machine-readable spec package lives. Read at runtime — it is the
# source of truth for error statuses, permissions and the event envelope.
# Defaults to the checkout layout; the container image sets it explicitly.
# SPEC_ROOT=/app/docs/forest_platform_machine_readable_release0/forest_platform_release0
