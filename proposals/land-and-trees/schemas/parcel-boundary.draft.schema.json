{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forest.example/proposals/schemas/forests/parcel-boundary.draft.schema.json",
  "title": "ParcelBoundary (DRAFT)",
  "description": "One append-only version of a parcel's geometry (GEO-001). Corrections supersede; nothing is overwritten. DRAFT — not approved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "boundaryId",
    "homeInstanceId",
    "parcelId",
    "version",
    "geometry",
    "surveyMethod",
    "submittedBy",
    "submittedAt",
    "status"
  ],
  "properties": {
    "boundaryId": { "type": "string", "format": "uuid" },
    "homeInstanceId": { "type": "string", "format": "uuid" },
    "parcelId": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "description": "GeoJSON Polygon in WGS84 (EPSG:4326). Stored as GEOGRAPHY so area and distance are correct without a local projection. Must be closed, simple and non-self-intersecting; the database rejects the rest with PARCEL_BOUNDARY_INVALID.",
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            }
          }
        }
      }
    },
    "surveyMethod": {
      "enum": ["gps_walk", "satellite_trace", "cadastral_record", "participatory_mapping"],
      "description": "How the shape was obtained. Bears directly on how much a boundary should be trusted, so it is required rather than optional."
    },
    "accuracyMetres": { "type": ["number", "null"], "minimum": 0 },
    "supportingEvidence": {
      "type": "array",
      "description": "Survey traces, cadastral documents, signed community maps (EVID-001).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceAssetId", "checksumSha256"],
        "properties": {
          "evidenceAssetId": { "type": "string", "format": "uuid" },
          "checksumSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "submittedBy": { "type": "string", "format": "uuid" },
    "submittedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["submitted", "approved", "rejected", "superseded"] },
    "approvedBy": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "parcel.approve_boundary is approved as critical, aal3, dual control. Approval therefore requires an approval record, which is drafted separately — until then the platform refuses the operation."
    },
    "approvedAt": { "type": ["string", "null"], "format": "date-time" },
    "rejectionReason": { "type": ["string", "null"] },
    "supersededByBoundaryId": { "type": ["string", "null"], "format": "uuid" }
  }
}
