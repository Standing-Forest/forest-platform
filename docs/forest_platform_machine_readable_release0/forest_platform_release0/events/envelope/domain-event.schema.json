{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forest.example/events/envelope/domain-event.schema.json",
  "title": "DomainEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateType",
    "aggregateId",
    "aggregateSequence",
    "actor",
    "occurredAt",
    "recordedAt",
    "correlationId",
    "sourceInstanceId",
    "sourceService",
    "dataClassification",
    "requirementIds",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]+$"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "aggregateType": {
      "type": "string"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateSequence": {
      "type": "integer",
      "minimum": 1
    },
    "actor": {
      "type": "object"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceInstanceId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceService": {
      "type": "string"
    },
    "dataClassification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "cultural_restricted"
      ]
    },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object"
    }
  }
}
