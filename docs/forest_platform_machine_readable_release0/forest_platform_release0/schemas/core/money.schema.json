{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forest.example/schemas/core/money.schema.json",
  "title": "Money",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "minorUnits",
    "currency"
  ],
  "properties": {
    "minorUnits": {
      "type": "integer"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  }
}
